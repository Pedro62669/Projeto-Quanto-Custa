# Dependências (cada projeto tem as suas; ver também backend/.gitignore e
# frontend/.gitignore, que o git aplica em cascata)
/node_modules

# Segredos — NUNCA versionar.
# Os arquivos .env carregam senha de banco e credenciais de admin.
# Use os .env.example como referência.
.env
.env.*
!.env.example

# Documentos internos de planejamento
#
# Este repositório é PÚBLICO. A pasta guarda os documentos de negócio que
# orientaram o desenvolvimento — incluindo .docx com estratégia e precificação —
# e nada ali é necessário para rodar ou entender o código.
#
# Publicar é irreversível na prática: o GitHub mantém o objeto acessível pelo
# hash mesmo depois de um commit que o remova, e buscadores podem já ter copiado.
# Os arquivos continuam no disco de quem desenvolve, fora do versionamento.
/docs.desenvolvimento/

# Sistema operacional / editores
.DS_Store
Thumbs.db
/.idea
/.vscode
/.zed

# Logs
*.log
npm-debug.log*

# Modelos 3D de referência
#
# mailer/mailer.py é a FONTE da geometria da mailer (o MailerMesh é port dele)
# e o .blend é o resultado que o cliente abre no Blender: os dois entram no
# repositório. Já o .blend1 é o backup automático do Blender — muda a cada
# salvamento e não descreve nada que o .blend já não descreva.
mailer/*.blend1
